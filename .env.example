# Google PageSpeed Insights API Key (опционально)
# Без ключа действует лимит ~25 000 запросов в день и 400 запросов на 100 сек.
# Получить ключ: https://developers.google.com/speed/docs/insights/v5/get-started
GOOGLE_PAGESPEED_API_KEY=

# Директория для сохранения отчетов
REPORT_OUTPUT_DIR=./reports

# Локальный URL для тестирования (если запускается локальный аудит)
PERF_BASE_URL=http://localhost:3000
